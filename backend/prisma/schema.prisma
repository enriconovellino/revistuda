// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String   @default("")
  permissions  String[] @default([])
  refreshToken String?
}

model Modulo {
  modulo_id        Int     @id @default(autoincrement())
  titulo_modulo    String
  descricao_modulo String?
  dificuldade      String
  imagem_url       String?
}

model Turma {
  turma_id         Int     @id @default(autoincrement())
  nome_turma       String
  descricao_turma  String?
  capacidade_maxima Int?
}

model Conteudo {
  conteudo_id    Int     @id @default(autoincrement())
  nome_conteudo  String
  tipo_conteudo  String 
  video_url      String?
  audio_link     String?
  texto_conteudo String?
}

model Licao {
  licao_id       Int     @id @default(autoincrement())
  titulo_licao   String
  comentario     String?
  modulo_id      Int
}

model Atividade {
  atividade_id         Int      @id @default(autoincrement())
  titulo_atividade     String   
  descricao_atividade  String?
  tipo_atividade       String
  licao_id             Int
}