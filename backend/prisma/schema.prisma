// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String   @default("")
  permissions  String[] @default([])
  refreshToken String?
  approved     Boolean  @default(true)
  turma_id     Int?
  turma        Turma?   @relation("AlunosDaTurma", fields: [turma_id], references: [turma_id])
  turmasComoProfessor Turma[] @relation("ProfessorDaTurma")
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  tentativasAssociacao TentativaAssociacao[]
  respostasMultiplaEscolha RespostaMultiplaEscolha[]
  comentarios  ComentarioAluno[]
  progressosAtividade ProgressoAtividade[]
  progressosConteudo  ProgressoConteudo[]
}

// Feed de eventos do painel admin (cadastros, aprovações, designações).
model AtividadeRecente {
  atividade_recente_id Int      @id @default(autoincrement())
  tipo                 String
  descricao            String
  data                 DateTime @default(now())
}

model Modulo {
  modulo_id        Int     @id @default(autoincrement())
  titulo_modulo    String
  descricao_modulo String?
  dificuldade      String
  imagem_url       String?
  turma_id         Int
  turma            Turma   @relation(fields: [turma_id], references: [turma_id])
  licoes           Licao[]
}

model Turma {
  turma_id         Int     @id @default(autoincrement())
  nome_turma       String
  descricao_turma  String?
  capacidade_maxima Int?
  professor_id     Int?
  professor        User?    @relation("ProfessorDaTurma", fields: [professor_id], references: [id])
  alunos           User[]   @relation("AlunosDaTurma")
  modulos          Modulo[]
}

model Conteudo {
  conteudo_id    Int     @id @default(autoincrement())
  nome_conteudo  String
  tipo_conteudo  String 
  url_conteudo   String?
  texto_conteudo String?
  licao_id       Int
  licao          Licao   @relation(fields: [licao_id], references: [licao_id])
  comentarios    ComentarioAluno[]
  progressos     ProgressoConteudo[]
}

model Licao {
  licao_id       Int     @id @default(autoincrement())
  titulo_licao   String
  comentario     String?
  modulo_id      Int
  modulo         Modulo  @relation(fields: [modulo_id], references: [modulo_id])
  conteudos      Conteudo[]
  atividades     Atividade[]
}

model Atividade {
  atividade_id         Int      @id @default(autoincrement())
  titulo_atividade     String
  tipo_atividade       String
  enunciado            String?
  explicacao           String?
  data_criacao         DateTime @default(now())
  licao_id             Int
  licao                Licao    @relation(fields: [licao_id], references: [licao_id], onDelete: Cascade)
  multipla_escolha     MultiplaEscolha?
  associacao_imagens   AssociacaoImagens?
  progressos           ProgressoAtividade[]
}

model ProgressoAtividade {
  progresso_id   Int       @id @default(autoincrement())
  aluno_id       Int
  atividade_id   Int
  status         String    // a_fazer | fazendo | feito
  data_inicio    DateTime?
  data_conclusao DateTime?
  aluno          User      @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  atividade      Atividade @relation(fields: [atividade_id], references: [atividade_id], onDelete: Cascade)

  @@unique([aluno_id, atividade_id])
}

model ProgressoConteudo {
  progresso_id   Int      @id @default(autoincrement())
  aluno_id       Int
  conteudo_id    Int
  data_conclusao DateTime @default(now())
  aluno          User     @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  conteudo       Conteudo @relation(fields: [conteudo_id], references: [conteudo_id], onDelete: Cascade)

  @@unique([aluno_id, conteudo_id])
}

model MultiplaEscolha {
  multipla_escolha_id Int       @id @default(autoincrement())
  atividade_id        Int       @unique
  atividade           Atividade @relation(fields: [atividade_id], references: [atividade_id], onDelete: Cascade)
  opcoes              Opcao[]
}

model Opcao {
  opcao_id            Int             @id @default(autoincrement())
  texto_opcao         String
  letra               String
  correta             Boolean
  multipla_escolha_id Int
  multipla_escolha    MultiplaEscolha @relation(fields: [multipla_escolha_id], references: [multipla_escolha_id], onDelete: Cascade)
  respostasAlunos     RespostaMultiplaEscolha[]
}

model RespostaMultiplaEscolha {
  resposta_me_id    Int      @id @default(autoincrement())
  aluno_id          Int
  aluno             User     @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  resposta_aluno_id Int
  opcao             Opcao    @relation(fields: [resposta_aluno_id], references: [opcao_id], onDelete: Cascade)
  data_resposta     DateTime @default(now())
}

model AssociacaoImagens {
  associacao_id       Int                  @id @default(autoincrement())
  atividade_id        Int                  @unique
  atividade           Atividade            @relation(fields: [atividade_id], references: [atividade_id], onDelete: Cascade)
  
  itens               ItemAssociacao[]
  tentativas          TentativaAssociacao[]
}

model ItemAssociacao {
  item_associacao_id  Int                  @id @default(autoincrement())
  tipo                String               
  texto               String?
  imagem_url          String?
  lado                String               
  
  associacao_id       Int
  associacao          AssociacaoImagens    @relation(fields: [associacao_id], references: [associacao_id], onDelete: Cascade)

  associacoes_corretas_1 AssociacaoCorreta[] @relation("Item1")
  associacoes_corretas_2 AssociacaoCorreta[] @relation("Item2")
  respostas_1            RespostaAssociacao[] @relation("RespItem1")
  respostas_2            RespostaAssociacao[] @relation("RespItem2")
}

model AssociacaoCorreta {
  item_1_id           Int
  item_2_id           Int

  item_1              ItemAssociacao       @relation("Item1", fields: [item_1_id], references: [item_associacao_id], onDelete: Cascade)
  item_2              ItemAssociacao       @relation("Item2", fields: [item_2_id], references: [item_associacao_id], onDelete: Cascade)

  @@id([item_1_id, item_2_id])
}

model TentativaAssociacao {
  tentativa_associacao_id Int              @id @default(autoincrement())
  user_id                 Int
  user                    User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  associacao_id           Int
  associacao              AssociacaoImagens @relation(fields: [associacao_id], references: [associacao_id], onDelete: Cascade)
  
  data_tentativa          DateTime         @default(now())
  respostas               RespostaAssociacao[]
}

model RespostaAssociacao {
  tentativa_associacao_id Int
  item_1_id               Int
  item_2_id               Int

  tentativa               TentativaAssociacao @relation(fields: [tentativa_associacao_id], references: [tentativa_associacao_id], onDelete: Cascade)
  item_1                  ItemAssociacao       @relation("RespItem1", fields: [item_1_id], references: [item_associacao_id], onDelete: Cascade)
  item_2                  ItemAssociacao       @relation("RespItem2", fields: [item_2_id], references: [item_associacao_id], onDelete: Cascade)

  @@id([tentativa_associacao_id, item_1_id, item_2_id])
}

model ComentarioAluno {
  id           Int      @id @default(autoincrement())
  texto        String
  alunoId      Int
  conteudoId   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resposta     String?
  respostaAt   DateTime?

  aluno        User     @relation(fields: [alunoId], references: [id])
  conteudo     Conteudo @relation(fields: [conteudoId], references: [conteudo_id])

  @@unique([alunoId, conteudoId]) 
}